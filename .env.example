# Database (isi salah satu)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Secret acak minimal 32 karakter untuk hashing metadata keamanan
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# URL publik aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP reset password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-secret
SMTP_FROM=CorpuKU Academy <mailer@example.com>

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Opsional: AI assistant
GEMINI_API_KEY=

# Host asset gambar yang diizinkan untuk PDF, dipisahkan koma
CERTIFICATE_ASSET_HOSTS=res.cloudinary.com

# Hanya bila Chromium pada hosting benar-benar memerlukannya
PUPPETEER_DISABLE_SANDBOX=false
